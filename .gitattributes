# Git line endings — normalize to LF in repo, check out as-is on all platforms
* text=auto eol=lf

# Java source files
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.dockerfile text eol=lf
Dockerfile text eol=lf

# Binary files — no line-ending processing
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
