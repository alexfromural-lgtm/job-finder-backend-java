# ==============================================================
# Stage 1: Build — GraalVM JDK 21 + Native Image Tools
# ==============================================================
FROM ghcr.io/graalvm/native-image-community:21 AS builder

WORKDIR /build

# Copy maven wrapper and pom.xml first for layer caching
COPY .mvn .mvn
COPY mvnw pom.xml ./

# Ensure the maven wrapper has execution permissions
RUN chmod +x mvnw

# Resolve dependencies (offline mode to cache layers)
RUN ./mvnw dependency:go-offline -B -q

# Copy application source code
COPY src ./src

# Build the native binary using Spring Boot 3 AOT Compilation
# This produces a native executable in target/job-finder-backend-java
RUN ./mvnw -Pnative native:compile -DskipTests -B

# ==============================================================
# Stage 2: Runtime — Minimal Debian Bookworm (No JVM needed)
# ==============================================================
FROM debian:bookworm-slim

WORKDIR /app

# Install ca-certificates and curl (required for actuator healthcheck)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Create a non-root system user/group for security
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy the compiled native executable from stage 1
COPY --from=builder /build/target/job-finder-backend-java app

# Ownership update for non-root execution
RUN chown appuser:appgroup app

USER appuser

EXPOSE 5002

# Run the standalone native binary directly
ENTRYPOINT ["./app"]
